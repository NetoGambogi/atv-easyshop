<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:EasyShop.ViewModels"
             xmlns:models="clr-namespace:EasyShop.Models"
             x:Class="EasyShop.Views.CustomersPage"
             x:DataType="vm:CustomersViewModel"
             Title="Clientes (SQL · SQLite)">

    <CollectionView ItemsSource="{Binding Customers}" SelectionMode="None" Margin="16,0">
        <CollectionView.Header>
            <VerticalStackLayout Spacing="10" Padding="0,16,0,8">
                <Label Text="Novo cliente" FontSize="20" FontAttributes="Bold" />

                <Entry Placeholder="Nome completo *" Text="{Binding FullName}" />
                <Entry Placeholder="E-mail *" Text="{Binding Email}" Keyboard="Email"
                       ReturnCommand="{Binding SaveCommand}" />

                <Button Text="Salvar cliente" Command="{Binding SaveCommand}" />

                <Label Text="{Binding StatusMessage}" TextColor="#2E7D32">
                    <Label.Triggers>
                        <DataTrigger TargetType="Label" Binding="{Binding HasError}" Value="True">
                            <Setter Property="TextColor" Value="#C62828" />
                        </DataTrigger>
                    </Label.Triggers>
                </Label>

                <BoxView HeightRequest="1" Color="LightGray" Margin="0,8" />
                <Label Text="Clientes cadastrados" FontSize="20" FontAttributes="Bold" />
            </VerticalStackLayout>
        </CollectionView.Header>

        <CollectionView.EmptyView>
            <Label Text="Nenhum cliente cadastrado ainda." TextColor="Gray" Margin="0,16" />
        </CollectionView.EmptyView>

        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="models:Customer">
                <Border Padding="12" Margin="0,0,0,10" StrokeShape="RoundRectangle 10" Stroke="LightGray">
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="8">
                        <Label Text="{Binding Name}" FontSize="16" FontAttributes="Bold" />
                        <Label Grid.Row="1" Text="{Binding Email}" FontSize="13" TextColor="Gray" />
                        <Label Grid.Column="1" Text="{Binding Id, StringFormat='#{0}'}"
                               FontSize="12" TextColor="Gray" HorizontalOptions="End" />
                        <Button Grid.Row="1" Grid.Column="1" Text="Excluir"
                                FontSize="12" Padding="8,2" HeightRequest="32"
                                BackgroundColor="#C62828"
                                Command="{Binding DeleteCommand, Source={RelativeSource AncestorType={x:Type vm:CustomersViewModel}}, x:DataType=vm:CustomersViewModel}"
                                CommandParameter="{Binding .}" />
                    </Grid>
                </Border>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentPage>
