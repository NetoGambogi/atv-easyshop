<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:EasyShop.ViewModels"
             xmlns:models="clr-namespace:EasyShop.Models"
             x:Class="EasyShop.Views.ProductsPage"
             x:DataType="vm:ProductsViewModel"
             Title="Produtos (NoSQL · LiteDB)">

    <CollectionView ItemsSource="{Binding Products}" SelectionMode="None" Margin="16,0">
        <CollectionView.Header>
            <VerticalStackLayout Spacing="10" Padding="0,16,0,8">
                <Label Text="Novo produto" FontSize="20" FontAttributes="Bold" />

                <Entry Placeholder="Nome do produto *" Text="{Binding Name}" />
                <Entry Placeholder="Preço * (ex.: 199,90)" Text="{Binding PriceText}" Keyboard="Numeric" />
                <Entry Placeholder="Categoria (opcional)" Text="{Binding Category}" />

                <Label Text="Atributos dinâmicos (opcional)" FontAttributes="Bold" Margin="0,6,0,0" />
                <Label Text="Ex.: Cor = Azul, Tamanho = M, Voltagem = 220V, RAM = 16GB"
                       FontSize="12" TextColor="Gray" />

                <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="8">
                    <Entry Grid.Column="0" Placeholder="Atributo" Text="{Binding NewAttributeKey}" />
                    <Entry Grid.Column="1" Placeholder="Valor" Text="{Binding NewAttributeValue}"
                           ReturnCommand="{Binding AddAttributeCommand}" />
                    <Button Grid.Column="2" Text="+" FontSize="18" WidthRequest="48"
                            Command="{Binding AddAttributeCommand}" />
                </Grid>

                <FlexLayout BindableLayout.ItemsSource="{Binding PendingAttributes}" Wrap="Wrap">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:AttributeEntry">
                            <Border Padding="10,4" Margin="0,0,6,6" StrokeShape="RoundRectangle 14"
                                    BackgroundColor="#EDE7F6" Stroke="Transparent">
                                <HorizontalStackLayout Spacing="6">
                                    <Label VerticalOptions="Center" TextColor="#311B92">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding Key}" FontAttributes="Bold" />
                                                <Span Text=": " />
                                                <Span Text="{Binding Value}" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                    <Label Text="✕" VerticalOptions="Center" TextColor="#B71C1C">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding RemoveAttributeCommand, Source={RelativeSource AncestorType={x:Type vm:ProductsViewModel}}, x:DataType=vm:ProductsViewModel}"
                                                CommandParameter="{Binding .}" />
                                        </Label.GestureRecognizers>
                                    </Label>
                                </HorizontalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>

                <Button Text="Salvar produto" Command="{Binding SaveCommand}" />

                <Label Text="{Binding StatusMessage}" TextColor="#2E7D32">
                    <Label.Triggers>
                        <DataTrigger TargetType="Label" Binding="{Binding HasError}" Value="True">
                            <Setter Property="TextColor" Value="#C62828" />
                        </DataTrigger>
                    </Label.Triggers>
                </Label>

                <BoxView HeightRequest="1" Color="LightGray" Margin="0,8" />
                <Label Text="Catálogo de produtos" FontSize="20" FontAttributes="Bold" />
            </VerticalStackLayout>
        </CollectionView.Header>

        <CollectionView.EmptyView>
            <Label Text="Nenhum produto cadastrado ainda." TextColor="Gray" Margin="0,16" />
        </CollectionView.EmptyView>

        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="models:Product">
                <Border Padding="12" Margin="0,0,0,10" StrokeShape="RoundRectangle 10" Stroke="LightGray">
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8">
                        <Label Text="{Binding Name}" FontSize="16" FontAttributes="Bold" />
                        <Label Grid.Column="1" Text="{Binding Price, StringFormat='{0:C}'}"
                               FontAttributes="Bold" TextColor="#512BD4" />
                        <Label Grid.Row="1" Text="{Binding Category, StringFormat='Categoria: {0}', TargetNullValue='Sem categoria'}"
                               FontSize="13" TextColor="Gray" />
                        <Label Grid.Row="2" Text="{Binding AttributesSummary}" FontSize="13" />
                        <Button Grid.Row="1" Grid.RowSpan="2" Grid.Column="1" Text="Excluir"
                                FontSize="12" Padding="8,2" HeightRequest="32" VerticalOptions="End"
                                BackgroundColor="#C62828"
                                Command="{Binding DeleteCommand, Source={RelativeSource AncestorType={x:Type vm:ProductsViewModel}}, x:DataType=vm:ProductsViewModel}"
                                CommandParameter="{Binding .}" />
                    </Grid>
                </Border>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentPage>
